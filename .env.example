# Server Port (defaults to 3000)
PORT=3000

# Environment Mode ('development' | 'production')
# In production, disk writes to .smpg_config.json and .smpg_history.json are disabled,
# and base64 payloads are returned by default for stateless agents.
NODE_ENV=production

# Gemini AI API Key (Optional for offline quotes, required for AI quote generation)
GEMINI_API_KEY=

# Public Base URL for reverse proxy / CDN URL construction for /output/* image assets
# Example: https://smpg.yourdomain.com
PUBLIC_BASE_URL=

# Cloudflare Pages Serverless Authentication Token
# Protects all /api/* (except GET /api/health) and /mcp endpoints in serverless deployments.
# Clients authenticate via Authorization: Bearer <TOKEN>, x-smpg-token: <TOKEN>, or ?token=<TOKEN>
# To configure in Cloudflare Pages:
#   npx wrangler pages secret put SMPG_AUTH_TOKEN
SMPG_AUTH_TOKEN=
