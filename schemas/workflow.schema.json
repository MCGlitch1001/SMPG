{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SMPGWorkflow",
  "description": "Declarative Workflow Language Specification for Social Media Post Generation",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name for the workflow run"
    },
    "format": {
      "type": "string",
      "enum": ["carousel", "reel"],
      "default": "carousel",
      "description": "Post format: 1:1 square carousel or 9:16 vertical reel"
    },
    "input": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "description": "Core topic, vibe, or niche concept"
        },
        "numPosts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1
        },
        "slidesPerPost": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "quotes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicit list of quotes. If provided, skips LLM generation"
        },
        "backgroundPrompt": {
          "type": "string",
          "description": "Custom prompt for background image generation"
        },
        "bgMode": {
          "type": "string",
          "enum": ["image", "color"],
          "default": "image"
        },
        "bgColor": {
          "type": "string",
          "default": "#09090b",
          "description": "Hex color code for solid background mode"
        },
        "imageUrl": {
          "type": "string",
          "description": "Direct image URL for background"
        },
        "imagePath": {
          "type": "string",
          "description": "Local filesystem path to background image"
        }
      },
      "required": ["topic"]
    },
    "theme": {
      "type": "object",
      "properties": {
        "fontProfile": {
          "type": "string",
          "enum": ["BigShoulders", "Outfit", "Lora", "GeistMono", "Bricolage", "Crimson"],
          "default": "BigShoulders"
        },
        "fontSize": {
          "type": "integer",
          "minimum": 30,
          "maximum": 140
        },
        "watermark": {
          "type": "string",
          "description": "Handle or brand tag to display on slides e.g. @discipline_archive"
        }
      }
    },
    "generator": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "default": "gemini-2.5-flash"
        },
        "apiKey": {
          "type": "string",
          "description": "Gemini API Key (optional if set in environment)"
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "default": "./output"
        },
        "saveImages": {
          "type": "boolean",
          "default": true
        },
        "returnBase64": {
          "type": "boolean",
          "default": false
        },
        "generateCaptions": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "required": ["input"]
}
