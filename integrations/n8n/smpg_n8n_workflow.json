{
  "name": "SMPG Social Media Post Generator",
  "nodes": [
    {
      "parameters": {},
      "id": "e0b51ad8-1234-4b5c-8901-a1b2c3d4e5f6",
      "name": "When clicking Execute Workflow",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "topic-param",
              "name": "topic",
              "value": "Stoic discipline in the face of chaos",
              "type": "string"
            },
            {
              "id": "format-param",
              "name": "format",
              "value": "carousel",
              "type": "string"
            },
            {
              "id": "slides-param",
              "name": "slidesCount",
              "value": 3,
              "type": "number"
            },
            {
              "id": "font-param",
              "name": "fontProfile",
              "value": "BigShoulders",
              "type": "string"
            },
            {
              "id": "watermark-param",
              "name": "watermark",
              "value": "@stoic.archive",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "e0b51ad8-2234-4b5c-8901-a1b2c3d4e5f7",
      "name": "Set Post Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"topic\": \"{{ $json.topic }}\",\n  \"format\": \"{{ $json.format }}\",\n  \"slidesCount\": {{ $json.slidesCount }},\n  \"fontProfile\": \"{{ $json.fontProfile }}\",\n  \"watermark\": \"{{ $json.watermark }}\"\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "e0b51ad8-3234-4b5c-8901-a1b2c3d4e5f8",
      "name": "Call SMPG Workflow Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Transform SMPG engine output for social media posting nodes\nconst result = $input.first().json;\n\nif (!result.success || !result.posts || result.posts.length === 0) {\n  throw new Error('SMPG Generation failed or returned empty results: ' + JSON.stringify(result));\n}\n\nconst post = result.posts[0];\nreturn {\n  json: {\n    workflowName: result.workflowName,\n    format: result.format,\n    topic: result.topic,\n    caption: post.caption,\n    totalSlides: post.slides.length,\n    imageUrls: post.slides.map(s => s.url),\n    imageFilePaths: post.slides.map(s => s.filePath),\n    slides: post.slides,\n    outputDirectory: result.outputDirectory,\n    timestamp: result.createdAt\n  }\n};"
      },
      "id": "e0b51ad8-4234-4b5c-8901-a1b2c3d4e5f9",
      "name": "Format For Social Nodes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ]
    }
  ],
  "connections": {
    "When clicking Execute Workflow": {
      "main": [
        [
          {
            "node": "Set Post Parameters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Post Parameters": {
      "main": [
        [
          {
            "node": "Call SMPG Workflow Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call SMPG Workflow Engine": {
      "main": [
        [
          {
            "node": "Format For Social Nodes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
